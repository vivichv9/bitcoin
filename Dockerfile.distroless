FROM alpine:3.21 AS builder

ARG ALPINE_REPO_BASE=https://mirrors.edge.kernel.org/alpine
ARG ALPINE_VERSION=v3.21
ARG JOBS=0

RUN printf '%s\n' \
    "${ALPINE_REPO_BASE}/${ALPINE_VERSION}/main" \
    "${ALPINE_REPO_BASE}/${ALPINE_VERSION}/community" \
    > /etc/apk/repositories

RUN apk add --no-cache \
    bash \
    bison \
    build-base \
    cmake \
    curl \
    linux-headers \
    make \
    patch \
    pkgconf \
    python3 \
    samurai \
    xz

WORKDIR /src
COPY . .

RUN set -eux; \
    if [ "${JOBS}" = "0" ]; then JOBS="$(nproc)"; fi; \
    make -C depends -j"${JOBS}" \
      NO_QT=1 \
      NO_WALLET=1 \
      NO_ZMQ=1 \
      NO_USDT=1 \
      NO_IPC=1; \
    HOST_TRIPLET="$(for d in depends/*-linux-musl; do [ -d "${d}" ] && basename "${d}" && break; done)"; \
    test -n "${HOST_TRIPLET}"; \
    cmake -B build -G Ninja \
      --toolchain="depends/${HOST_TRIPLET}/toolchain.cmake" \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_EXE_LINKER_FLAGS="-static" \
      -DBUILD_DAEMON=ON \
      -DBUILD_CLI=OFF \
      -DBUILD_TX=OFF \
      -DBUILD_UTIL=OFF \
      -DBUILD_TESTS=OFF \
      -DBUILD_BENCH=OFF \
      -DBUILD_FUZZ_BINARY=OFF \
      -DENABLE_WALLET=OFF \
      -DWITH_ZMQ=OFF \
      -DENABLE_IPC=OFF; \
    cmake --build build --target bitcoind -j"${JOBS}"; \
    strip build/bin/bitcoind; \
    ! readelf -d build/bin/bitcoind | grep -q NEEDED

FROM scratch AS runtime

COPY --from=builder /src/build/bin/bitcoind /usr/local/bin/bitcoind

EXPOSE 8332 8333
VOLUME ["/data"]

ENTRYPOINT ["/usr/local/bin/bitcoind"]
CMD ["--help"]
